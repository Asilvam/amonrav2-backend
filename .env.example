PORT=3500
NODE_ENV=development

# MongoDB Atlas connection string (keep credentials private).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Exact frontend origins allowed to call this API.
WEB_ORIGINS=http://localhost:4321,https://www.amonra.cl
PUBLIC_SITE_URL=https://www.amonra.cl

# Existing NestJS email microservice.
EMAIL_SERVICE_API_URL=https://your-email-service.example/email
EMAIL_SERVICE_API_KEY=replace-with-email-service-api-key

# Single-admin access. Use unique random values, never commit real secrets.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SAME_SITE=lax

# Set true only when the public reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
